# --- Required in every environment ---

# Public origin of this deployment. Used to build magic-link URLs and form
# endpoint URLs. Must be HTTPS when NODE_ENV=production (docker compose sets that).
PUBLIC_URL=https://forms.example.com

# HMAC key for sessions and CSRF tokens, at least 32 random bytes.
# Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-bytes

# From address for sign-in emails. With EMAIL_PROVIDER=resend this must be
# on your Resend-verified domain.
EMAIL_FROM=Shibumi Forms <forms@example.com>

# resend = send real email (needs RESEND_API_KEY). discard = build UI but
# silently drop sign-in mail (dev only; nobody can sign in via email).
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Shown in the footer and the registration consent checkbox.
# TERMS_VERSION is stored with each signup; bump it when terms change.
TERMS_URL=https://forms.example.com/terms
TERMS_VERSION=1
PRIVACY_URL=https://forms.example.com/privacy

# --- Optional ---

# Cloudflare Turnstile on auth forms. Set both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# loopback = trust X-Forwarded-For only from 127.0.0.1 (reverse proxy on the
# same host). Anything else disables the header.
TRUSTED_PROXY=loopback

# Shown in deletion copy; keep aligned with your actual backup rotation.
BACKUP_RETENTION_DAYS=30

# --- Local development (bun dev) overrides ---
# NODE_ENV=development
# PORT=3000
# PUBLIC_URL=http://localhost:3000
# DATABASE_PATH=./data/shibumi-forms.sqlite
# EMAIL_PROVIDER=discard
# In docker compose, NODE_ENV/PORT/DATABASE_PATH are set by compose.yaml; do
# not set them here for container deploys.
